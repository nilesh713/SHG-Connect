# ---------- Required ----------
# Local MongoDB or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/shgconnect
# Use a long random string (e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
PORT=5000
NODE_ENV=development

# ---------- Optional ----------
# How long a login stays valid
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed origins for CORS (frontend is served by the same server by default)
CORS_ORIGIN=http://localhost:5000
# true = newly published products wait for admin approval; false = they go live immediately
PRODUCT_APPROVAL_REQUIRED=false

# Cloudinary image storage (leave blank to store uploads locally in /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
